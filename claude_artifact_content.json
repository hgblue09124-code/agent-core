{"title":"personal-agent-ui.html","description":"High-fidelity iOS UI concept for a private, on-device AI agent app. Features dark theme, status indicators, task execution, memory vault, and settings screens with SwiftUI-inspired design.","language":null,"type":"text/html","content":"<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Personal Agent — UI Concept</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap');\n\n  :root{\n    --bg-0:#020203;\n    --bg-1:#0A0A0D;\n    --bg-2:#141417;\n    --bg-3:#1D1D22;\n    --bg-4:#26262C;\n    --hair:rgba(255,255,255,.08);\n    --hair-strong:rgba(255,255,255,.14);\n    --text-1:#F5F5F7;\n    --text-2:rgba(245,245,247,.62);\n    --text-3:rgba(245,245,247,.36);\n    --accent:#7C8CFF;\n    --accent-dim:rgba(124,140,255,.14);\n    --violet:#B18CFF;\n    --cyan:#7FE0E0;\n    --success:#3DD68C;\n    --success-dim:rgba(61,214,140,.14);\n    --warning:#F5B84D;\n    --warning-dim:rgba(245,184,77,.14);\n    --danger:#F5716B;\n    --danger-dim:rgba(245,113,107,.14);\n    --offline:#8B8B92;\n    --font:'Inter',-apple-system,BlinkMacSystemFont,'SF Pro Display','Helvetica Neue',sans-serif;\n    --mono:'Roboto Mono',monospace;\n  }\n  *{box-sizing:border-box; margin:0; padding:0;}\n  body{\n    background:\n      radial-gradient(ellipse 1200px 700px at 20% -10%, rgba(124,140,255,.08), transparent 60%),\n      radial-gradient(ellipse 1000px 600px at 90% 10%, rgba(177,140,255,.06), transparent 60%),\n      var(--bg-0);\n    color:var(--text-1);\n    font-family:var(--font);\n    padding:64px 40px 120px;\n  }\n  .wrap{max-width:1400px; margin:0 auto;}\n\n  /* ---------- shared page chrome ---------- */\n  .eyebrow{\n    font-size:12.5px; color:var(--text-3); letter-spacing:.02em; margin-bottom:6px;\n  }\n  .section-title{\n    font-size:22px; font-weight:600; color:var(--text-1); margin-bottom:4px;\n  }\n  .section-sub{\n    font-size:14px; color:var(--text-2); max-width:560px; line-height:1.55;\n  }\n  .section-head{ margin-bottom:36px; }\n  .divider{ height:1px; background:var(--hair); margin:88px 0 64px; }\n\n  /* ---------- phone frame ---------- */\n  .phone{\n    position:relative;\n    background:#000;\n    border-radius:52px;\n    padding:12px;\n    box-shadow:\n      0 0 0 1px rgba(255,255,255,.06),\n      0 40px 80px -20px rgba(0,0,0,.7),\n      0 0 120px -30px rgba(124,140,255,.18);\n  }\n  .phone .screen{\n    position:relative;\n    width:100%; height:100%;\n    background:var(--bg-1);\n    border-radius:40px;\n    overflow:hidden;\n    display:flex; flex-direction:column;\n  }\n  .phone.hero{ width:352px; height:756px; }\n  .phone.small{ width:264px; height:566px; padding:9px; border-radius:40px; }\n  .phone.small .screen{ border-radius:31px; }\n\n  .island{\n    position:absolute; top:14px; left:50%; transform:translateX(-50%);\n    width:96px; height:28px; background:#000; border-radius:20px; z-index:20;\n  }\n  .statusbar{\n    display:flex; justify-content:space-between; align-items:center;\n    padding:16px 26px 0; font-size:14px; font-weight:600; color:var(--text-1); flex-shrink:0;\n  }\n  .statusbar .icons{ display:flex; gap:5px; align-items:center; opacity:.9}\n\n  .tabbar{\n    margin-top:auto; flex-shrink:0;\n    display:flex; justify-content:space-around; align-items:center;\n    padding:10px 8px calc(10px + 18px);\n    background:rgba(20,20,23,.72);\n    backdrop-filter:blur(20px);\n    border-top:1px solid var(--hair);\n  }\n  .tabbar .tab{\n    display:flex; flex-direction:column; align-items:center; gap:4px;\n    color:var(--text-3); font-size:10.5px; font-weight:500; width:56px;\n  }\n  .tabbar .tab.active{ color:var(--text-1); }\n  .tabbar .tab.active svg{ stroke:var(--accent); }\n  .tabbar svg{ stroke:var(--text-3); }\n  .tabbar .tab.active .dot{ display:block; }\n  .tabbar .dot{ display:none; width:3px; height:3px; border-radius:50%; background:var(--accent); position:absolute; margin-top:-30px;}\n\n  .scr-content{ flex:1; overflow:hidden; padding:20px 20px 12px; display:flex; flex-direction:column; gap:16px; }\n\n  svg.icon{ width:18px; height:18px; stroke:currentColor; stroke-width:1.6; fill:none; stroke-linecap:round; stroke-linejoin:round; }\n\n  /* ---------- generic UI atoms used inside phones ---------- */\n  .h1{ font-size:26px; font-weight:600; letter-spacing:-.01em; }\n  .h2{ font-size:17px; font-weight:600; }\n  .cap{ font-size:12px; color:var(--text-3); font-weight:500; text-transform:none; }\n  .muted{ color:var(--text-2); font-size:13px; line-height:1.4; }\n\n  .card{\n    background:var(--bg-2);\n    border:1px solid var(--hair);\n    border-radius:20px;\n    padding:16px;\n  }\n  .row{ display:flex; align-items:center; gap:10px; }\n  .between{ display:flex; align-items:center; justify-content:space-between; }\n\n  .pill{\n    display:inline-flex; align-items:center; gap:6px;\n    padding:5px 11px; border-radius:100px;\n    font-size:11.5px; font-weight:500;\n  }\n  .pill.ready{ background:var(--success-dim); color:var(--success); }\n  .pill.thinking{ background:var(--accent-dim); color:var(--accent); }\n  .pill.running{ background:var(--warning-dim); color:var(--warning); }\n  .pill.offline{ background:rgba(139,139,146,.16); color:var(--offline); }\n  .pill.error{ background:var(--danger-dim); color:var(--danger); }\n  .pill .pdot{ width:6px; height:6px; border-radius:50%; background:currentColor; }\n  .pill.thinking .pdot, .pill.running .pdot{ animation:pulse 1.4s ease-in-out infinite; }\n  @keyframes pulse{ 0%,100%{opacity:1} 50%{opacity:.35} }\n\n  .icon-tile{\n    width:38px; height:38px; border-radius:12px;\n    display:flex; align-items:center; justify-content:center;\n    background:var(--bg-3); border:1px solid var(--hair); flex-shrink:0;\n  }\n  .icon-tile.accent{ background:var(--accent-dim); border-color:transparent; }\n  .icon-tile.accent svg{ stroke:var(--accent); }\n  .icon-tile.success{ background:var(--success-dim); }\n  .icon-tile.success svg{ stroke:var(--success); }\n  .icon-tile.warning{ background:var(--warning-dim); }\n  .icon-tile.warning svg{ stroke:var(--warning); }\n  .icon-tile.danger{ background:var(--danger-dim); }\n  .icon-tile.danger svg{ stroke:var(--danger); }\n\n  /* orb */\n  .orb-wrap{ display:flex; flex-direction:column; align-items:center; gap:14px; padding:18px 0 6px; }\n  .orb{\n    width:118px; height:118px; border-radius:50%;\n    position:relative;\n    background:conic-gradient(from 180deg, #4B5BE0, #7C8CFF, #B18CFF, #7FE0E0, #4B5BE0);\n    filter:saturate(0.9);\n    display:flex; align-items:center; justify-content:center;\n  }\n  .orb::after{\n    content:''; position:absolute; inset:6px; border-radius:50%;\n    background:var(--bg-1); opacity:.86;\n  }\n  .orb .core{ position:relative; z-index:2; width:14px; height:14px; border-radius:50%; background:var(--text-1); box-shadow:0 0 18px 4px rgba(124,140,255,.6);}\n  .orb.thinking{ animation:spin 5s linear infinite; }\n  @keyframes spin{ to{ transform:rotate(360deg);} }\n\n  .btn{\n    display:flex; align-items:center; justify-content:center; gap:8px;\n    height:52px; border-radius:26px; font-size:15px; font-weight:600;\n    background:var(--accent); color:#0A0A0D; border:none;\n  }\n  .btn.ghost{ background:var(--bg-3); color:var(--text-1); border:1px solid var(--hair-strong); }\n\n  .input-pill{\n    display:flex; align-items:center; gap:10px;\n    background:var(--bg-2); border:1px solid var(--hair-strong);\n    border-radius:24px; padding:13px 16px; color:var(--text-3); font-size:14.5px;\n  }\n  .input-pill svg{ stroke:var(--text-3); flex-shrink:0; }\n\n  .list-item{\n    display:flex; align-items:center; gap:12px; padding:12px 2px;\n    border-bottom:1px solid var(--hair);\n  }\n  .list-item:last-child{ border-bottom:none; }\n\n  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }\n\n  .seg{\n    display:flex; background:var(--bg-2); border:1px solid var(--hair); border-radius:14px; padding:3px;\n  }\n  .seg span{ flex:1; text-align:center; font-size:12.5px; font-weight:500; padding:7px 0; border-radius:11px; color:var(--text-3); }\n  .seg span.on{ background:var(--bg-4); color:var(--text-1); }\n\n  .toggle{ width:42px; height:25px; border-radius:14px; background:var(--bg-4); position:relative; flex-shrink:0; }\n  .toggle.on{ background:var(--accent); }\n  .toggle::after{ content:''; position:absolute; top:2.5px; left:3px; width:20px; height:20px; border-radius:50%; background:#fff; }\n  .toggle.on::after{ left:auto; right:3px; }\n\n  .chip{\n    display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:500;\n    padding:3px 9px; border-radius:8px; background:var(--bg-3); color:var(--text-2); border:1px solid var(--hair);\n  }\n  .chip.local{ background:rgba(61,214,140,.12); color:var(--success); border-color:transparent; }\n\n  .progressbar{ height:4px; border-radius:4px; background:var(--bg-4); overflow:hidden; }\n  .progressbar > div{ height:100%; background:var(--accent); border-radius:4px; }\n\n  .scrollhide::-webkit-scrollbar{ display:none; }\n\n  /* ---------- layout grids ---------- */\n  .hero-row{ display:flex; gap:56px; align-items:flex-start; }\n  .hero-caption{ padding-top:80px; max-width:340px; }\n  .hero-caption .h1{ font-size:34px; margin-bottom:14px; }\n  .hero-caption .muted{ font-size:15px; margin-bottom:28px; }\n  .kv{ display:flex; gap:10px; margin-bottom:14px; }\n  .kv .k{ width:120px; font-size:12.5px; color:var(--text-3); flex-shrink:0; padding-top:2px;}\n  .kv .v{ font-size:13.5px; color:var(--text-2); line-height:1.5; }\n\n  .screens-grid{ display:flex; flex-wrap:wrap; gap:40px; justify-content:flex-start; }\n  .screen-block{ display:flex; flex-direction:column; align-items:center; gap:18px; }\n  .screen-label{ text-align:center; }\n  .screen-label .name{ font-size:14px; font-weight:600; }\n  .screen-label .desc{ font-size:12px; color:var(--text-3); margin-top:2px; }\n\n  .states-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }\n  .state-card{\n    background:var(--bg-2); border:1px solid var(--hair); border-radius:18px; padding:18px;\n    display:flex; flex-direction:column; gap:12px; min-height:150px;\n  }\n  .state-card .tag{ font-size:11px; font-weight:600; color:var(--text-3); }\n\n  .tok-row{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }\n  .swatch{ border-radius:14px; height:64px; border:1px solid var(--hair); position:relative; overflow:hidden; }\n  .swatch .lbl{ position:absolute; bottom:8px; left:10px; font-size:11px; font-family:var(--mono); color:rgba(255,255,255,.85); }\n\n  .type-row{ display:flex; align-items:baseline; gap:16px; padding:14px 0; border-bottom:1px solid var(--hair); }\n  .type-row .tlabel{ width:150px; font-size:11px; color:var(--text-3); font-family:var(--mono); flex-shrink:0; }\n\n  .spacing-row{ display:flex; align-items:center; gap:14px; }\n  .spacing-bar{ height:10px; background:var(--accent); border-radius:3px; }\n\n  footer{ margin-top:100px; text-align:center; color:var(--text-3); font-size:12px; }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n  <!-- ============ SVG ICON DEFS ============ -->\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\">\n    <defs>\n      <symbol id=\"i-home\" viewBox=\"0 0 24 24\"><path d=\"M4 11.5 12 4l8 7.5\"/><path d=\"M6 10v9h12v-9\"/></symbol>\n      <symbol id=\"i-bolt\" viewBox=\"0 0 24 24\"><path d=\"M13 3 5 14h6l-1 7 8-11h-6z\"/></symbol>\n      <symbol id=\"i-activity\" viewBox=\"0 0 24 24\"><path d=\"M3 12h4l2 8 4-16 2 8h6\"/></symbol>\n      <symbol id=\"i-vault\" viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"3\"/><circle cx=\"12\" cy=\"12\" r=\"2.4\"/><path d=\"M12 9.6V7M12 17v-2.6\"/></symbol>\n      <symbol id=\"i-link\" viewBox=\"0 0 24 24\"><path d=\"M9 15l6-6\"/><path d=\"M11 6l1-1a4 4 0 0 1 6 6l-1 1\"/><path d=\"M13 18l-1 1a4 4 0 0 1-6-6l1-1\"/></symbol>\n      <symbol id=\"i-gear\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4\"/></symbol>\n      <symbol id=\"i-mic\" viewBox=\"0 0 24 24\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0 0 14 0\"/><path d=\"M12 18v3\"/></symbol>\n      <symbol id=\"i-search\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M20 20l-4.3-4.3\"/></symbol>\n      <symbol id=\"i-chevron\" viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"/></symbol>\n      <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></symbol>\n      <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></symbol>\n      <symbol id=\"i-clock\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 7.5V12l3 2\"/></symbol>\n      <symbol id=\"i-cloudoff\" viewBox=\"0 0 24 24\"><path d=\"M3 3l18 18\"/><path d=\"M17.5 17H7a4 4 0 0 1-.8-7.9A5.5 5.5 0 0 1 16.6 8\"/></symbol>\n      <symbol id=\"i-folder\" viewBox=\"0 0 24 24\"><path d=\"M4 6h5l2 2h9v10H4z\"/></symbol>\n      <symbol id=\"i-doc\" viewBox=\"0 0 24 24\"><path d=\"M6 3h8l4 4v14H6z\"/><path d=\"M14 3v4h4\"/></symbol>\n      <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></symbol>\n      <symbol id=\"i-arrowup\" viewBox=\"0 0 24 24\"><path d=\"M12 19V5M6 11l6-6 6 6\"/></symbol>\n      <symbol id=\"i-shield\" viewBox=\"0 0 24 24\"><path d=\"M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z\"/></symbol>\n      <symbol id=\"i-wifi\" viewBox=\"0 0 24 24\"><path d=\"M12 18h.01M8.5 14.5a5 5 0 0 1 7 0M5.5 11.2a9.5 9.5 0 0 1 13 0\"/></symbol>\n      <symbol id=\"i-bell\" viewBox=\"0 0 24 24\"><path d=\"M6 10a6 6 0 0 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 14 6 10z\"/><path d=\"M10 18.5a2 2 0 0 0 4 0\"/></symbol>\n      <symbol id=\"i-trash\" viewBox=\"0 0 24 24\"><path d=\"M5 7h14M9 7V5h6v2M7 7l1 13h8l1-13\"/></symbol>\n      <symbol id=\"i-battery\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"8\" width=\"17\" height=\"8\" rx=\"2\"/><path d=\"M21 11v2\"/></symbol>\n      <symbol id=\"i-cellular\" viewBox=\"0 0 24 24\"><path d=\"M4 18v-4M9.5 18v-8M15 18V7M20.5 18V3\"/></symbol>\n      <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 11v5M12 8v.01\"/></symbol>\n      <symbol id=\"i-repeat\" viewBox=\"0 0 24 24\"><path d=\"M4 7h13l-3-3M20 17H7l3 3\"/></symbol>\n      <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M7 5l12 7-12 7z\"/></symbol>\n    </defs>\n  </svg>\n\n  <!-- ============ HEADER ============ -->\n  <div class=\"section-head\">\n    <div class=\"eyebrow\">Personal Agent · iOS UI concept</div>\n    <div class=\"section-title\">A private, local-first agent — dark, quiet, deliberate</div>\n    <div class=\"section-sub\">High-fidelity concept for a personal AI agent app. Native SwiftUI feel, one restrained accent, and a clear answer to \"what is my agent doing, and what can I ask it?\" at every screen.</div>\n  </div>\n\n  <!-- ============ HERO: HOME SCREEN ============ -->\n  <div class=\"hero-row\">\n    <div class=\"phone hero\">\n      <div class=\"screen\">\n        <div class=\"island\"></div>\n        <div class=\"statusbar\">\n          <span>9:41</span>\n          <div class=\"icons\"><svg class=\"icon\" style=\"width:15px;height:15px\"><use href=\"#i-cellular\"/></svg><svg class=\"icon\" style=\"width:15px;height:15px\"><use href=\"#i-wifi\"/></svg><svg class=\"icon\" style=\"width:20px;height:15px\"><use href=\"#i-battery\"/></svg></div>\n        </div>\n\n        <div class=\"scr-content scrollhide\" style=\"overflow-y:auto\">\n          <div class=\"between\" style=\"margin-top:6px\">\n            <div>\n              <div class=\"cap\">Good evening</div>\n              <div class=\"h1\">Your agent</div>\n            </div>\n            <div class=\"icon-tile\"><svg class=\"icon\"><use href=\"#i-bell\"/></svg></div>\n          </div>\n\n          <!-- agent status card -->\n          <div class=\"card\" style=\"align-items:center; text-align:center;\">\n            <div class=\"between\" style=\"width:100%\">\n              <span class=\"pill ready\"><span class=\"pdot\"></span>Ready</span>\n              <span class=\"chip local\"><svg class=\"icon\" style=\"width:11px;height:11px\"><use href=\"#i-shield\"/></svg>On-device</span>\n            </div>\n            <div class=\"orb-wrap\">\n              <div class=\"orb\"><div class=\"core\"></div></div>\n              <div class=\"muted\" style=\"font-size:13px\">Idle · last active 4 minutes ago</div>\n            </div>\n            <div class=\"input-pill\" style=\"width:100%\">\n              <svg class=\"icon\"><use href=\"#i-mic\"/></svg>\n              <span style=\"flex:1; text-align:left\">Ask your agent to do something…</span>\n              <svg class=\"icon\"><use href=\"#i-arrowup\"/></svg>\n            </div>\n          </div>\n\n          <!-- quick actions -->\n          <div>\n            <div class=\"cap\" style=\"margin-bottom:10px\">Quick actions</div>\n            <div class=\"grid2\">\n              <div class=\"card\" style=\"padding:14px;\">\n                <div class=\"icon-tile accent\"><svg class=\"icon\"><use href=\"#i-bolt\"/></svg></div>\n                <div class=\"h2\" style=\"margin-top:10px; font-size:14.5px\">Run a task</div>\n              </div>\n              <div class=\"card\" style=\"padding:14px;\">\n                <div class=\"icon-tile\"><svg class=\"icon\"><use href=\"#i-vault\"/></svg></div>\n                <div class=\"h2\" style=\"margin-top:10px; font-size:14.5px\">Search memory</div>\n              </div>\n            </div>\n          </div>\n\n          <!-- current task -->\n          <div>\n            <div class=\"between\" style=\"margin-bottom:10px\">\n              <div class=\"cap\">Current task</div>\n              <span class=\"pill running\"><span class=\"pdot\"></span>Running</span>\n            </div>\n            <div class=\"card\">\n              <div class=\"row\">\n                <div class=\"icon-tile warning\"><svg class=\"icon\"><use href=\"#i-repeat\"/></svg></div>\n                <div style=\"flex:1\">\n                  <div class=\"h2\" style=\"font-size:14.5px\">Organizing travel receipts</div>\n                  <div class=\"muted\">Reading 12 files in Vault → Documents</div>\n                </div>\n              </div>\n              <div class=\"progressbar\" style=\"margin-top:12px\"><div style=\"width:64%\"></div></div>\n            </div>\n          </div>\n\n          <!-- recent activity -->\n          <div>\n            <div class=\"between\" style=\"margin-bottom:6px\">\n              <div class=\"cap\">Recent activity</div>\n              <span class=\"muted\" style=\"color:var(--accent)\">See all</span>\n            </div>\n            <div class=\"card\" style=\"padding:6px 14px;\">\n              <div class=\"list-item\">\n                <div class=\"icon-tile success\" style=\"width:32px;height:32px\"><svg class=\"icon\" style=\"width:15px;height:15px\"><use href=\"#i-check\"/></svg></div>\n                <div style=\"flex:1\">\n                  <div style=\"font-size:13.5px; font-weight:500\">Summarized weekly emails</div>\n                  <div class=\"muted\" style=\"font-size:11.5px\">2h ago · Local</div>\n                </div>\n              </div>\n              <div class=\"list-item\">\n                <div class=\"icon-tile danger\" style=\"width:32px;height:32px\"><svg class=\"icon\" style=\"width:15px;height:15px\"><use href=\"#i-x\"/></svg></div>\n                <div style=\"flex:1\">\n                  <div style=\"font-size:13.5px; font-weight:500\">Sync with calendar</div>\n                  <div class=\"muted\" style=\"font-size:11.5px\">Yesterday · Failed, permission needed</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"tabbar\">\n          <div class=\"tab active\"><svg class=\"icon\" style=\"width:21px;height:21px\"><use href=\"#i-home\"/></svg>Home<span class=\"dot\"></span></div>\n          <div class=\"tab\"><svg class=\"icon\" style=\"width:21px;height:21px\"><use href=\"#i-bolt\"/></svg>Agent</div>\n          <div class=\"tab\"><svg class=\"icon\" style=\"width:21px;height:21px\"><use href=\"#i-activity\"/></svg>Activity</div>\n          <div class=\"tab\"><svg class=\"icon\" style=\"width:21px;height:21px\"><use href=\"#i-vault\"/></svg>Vault</div>\n          <div class=\"tab\"><svg class=\"icon\" style=\"width:21px;height:21px\"><use href=\"#i-gear\"/></svg>Settings</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"hero-caption\">\n      <div class=\"h1\">Home</div>\n      <div class=\"muted\">One glance answers two questions: what state is my agent in, and what can I ask it to do right now. Everything else — quick actions, the active task, recent history — supports that.</div>\n      <div class=\"kv\"><div class=\"k\">Status</div><div class=\"v\">A single status pill (Ready / Thinking / Running / Offline) sits above the orb, always in the same place.</div></div>\n      <div class=\"kv\"><div class=\"k\">Center of gravity</div><div class=\"v\">The orb is the only place gradient and motion appear on this screen — it reads as \"the agent,\" not decoration.</div></div>\n      <div class=\"kv\"><div class=\"k\">Input</div><div class=\"v\">One pill-shaped composer, always docked under the orb. Typing or speaking both start here.</div></div>\n      <div class=\"kv\"><div class=\"k\">Privacy signal</div><div class=\"v\">The \"on-device\" chip is present wherever the agent is actively reasoning, not buried in settings.</div></div>\n    </div>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <!-- ============ OTHER SCREENS ============ -->\n  <div class=\"section-head\">\n    <div class=\"section-title\">The full system</div>\n    <div class=\"section-sub\">Five supporting screens, same tokens, same tab bar, same card language.</div>\n  </div>\n\n  <div class=\"screens-grid\">\n\n    <!-- AGENT / EXECUTE -->\n    <div class=\"screen-block\">\n      <div class=\"phone small\">\n        <div class=\"screen\">\n          <div class=\"island\" style=\"width:76px;height:22px;top:11px\"></div>\n          <div class=\"statusbar\" style=\"padding:12px 20px 0; font-size:12px\"><span>9:41</span><div class=\"icons\"><svg class=\"icon\" style=\"width:12px;height:12px\"><use href=\"#i-wifi\"/></svg></div></div>\n          <div class=\"scr-content\" style=\"padding:15px 15px 10px; gap:12px\">\n            <div class=\"between\">\n              <div class=\"h2\" style=\"font-size:16px\">Execute</div>\n              <span class=\"pill thinking\" style=\"font-size:10px\"><span class=\"pdot\"></span>Thinking</span>\n            </div>\n            <div class=\"card\" style=\"padding:12px;\">\n              <div class=\"cap\" style=\"margin-bottom:6px\">Task</div>\n              <div style=\"font-size:13px\">\"Draft replies to unread emails from this week and flag anything urgent.\"</div>\n            </div>\n            <div class=\"card\" style=\"padding:12px; gap:8px; display:flex; flex-direction:column;\">\n              <div class=\"row\"><svg class=\"icon\" style=\"width:14px;height:14px; stroke:var(--text-2)\"><use href=\"#i-check\"/></svg><span style=\"font-size:12px\" class=\"muted\">Read inbox — 41 messages</span></div>\n              <div class=\"row\"><svg class=\"icon\" style=\"width:14px;height:14px; stroke:var(--text-2)\"><use href=\"#i-check\"/></svg><span style=\"font-size:12px\" class=\"muted\">Grouped by sender</span></div>\n              <div class=\"row\"><div class=\"orb\" style=\"width:14px;height:14px\" ></div><span style=\"font-size:12px\">Drafting reply 3 of 7…</span></div>\n              <div class=\"progressbar\"><div style=\"width:38%\"></div></div>\n            </div>\n            <div style=\"display:flex; gap:8px; margin-top:auto\">\n              <div class=\"btn ghost\" style=\"flex:1; height:40px; font-size:12.5px\">Cancel</div>\n              <div class=\"btn ghost\" style=\"flex:1; height:40px; font-size:12.5px; opacity:.5\">Retry</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"screen-label\"><div class=\"name\">Agent / Execute</div><div class=\"desc\">Task in, live steps, cancel or retry</div></div>\n    </div>\n\n    <!-- ACTIVITY -->\n    <div class=\"screen-block\">\n      <div class=\"phone small\">\n        <div class=\"screen\">\n          <div class=\"island\" style=\"width:76px;height:22px;top:11px\"></div>\n          <div class=\"statusbar\" style=\"padding:12px 20px 0; font-size:12px\"><span>9:41</span><div class=\"icons\"><svg class=\"icon\" style=\"width:12px;height:12px\"><use href=\"#i-wifi\"/></svg></div></div>\n          <div class=\"scr-content\" style=\"padding:15px 15px 10px; gap:10px\">\n            <div class=\"h2\" style=\"font-size:16px\">Activity</div>\n            <div class=\"seg\"><span class=\"on\">All</span><span>Success</span><span>Failed</span></div>\n            <div class=\"card\" style=\"padding:6px 12px;\">\n              <div class=\"list-item\">\n                <div class=\"icon-tile success\" style=\"width:28px;height:28px\"><svg class=\"icon\" style=\"width:13px;height:13px\"><use href=\"#i-check\"/></svg></div>\n                <div style=\"flex:1\"><div style=\"font-size:12.5px;font-weight:500\">Backed up notes</div><div class=\"muted\" style=\"font-size:10.5px\">10:04 · 1.2s</div></div>\n              </div>\n              <div class=\"list-item\">\n                <div class=\"icon-tile danger\" style=\"width:28px;height:28px\"><svg class=\"icon\" style=\"width:13px;height:13px\"><use href=\"#i-x\"/></svg></div>\n                <div style=\"flex:1\"><div style=\"font-size:12.5px;font-weight:500\">Sync calendar</div><div class=\"muted\" style=\"font-size:10.5px\">09:41 · permission denied</div></div>\n              </div>\n              <div class=\"list-item\">\n                <div class=\"icon-tile success\" style=\"width:28px;height:28px\"><svg class=\"icon\" style=\"width:13px;height:13px\"><use href=\"#i-check\"/></svg></div>\n                <div style=\"flex:1\"><div style=\"font-size:12.5px;font-weight:500\">Weekly summary</div><div class=\"muted\" style=\"font-size:10.5px\">Yesterday · 8.4s</div></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"screen-label\"><div class=\"name\">Activity</div><div class=\"desc\">Timeline of every run, filterable</div></div>\n    </div>\n\n    <!-- MEMORY / VAULT -->\n    <div class=\"screen-block\">\n      <div class=\"phone small\">\n        <div class=\"screen\">\n          <div class=\"island\" style=\"width:76px;height:22px;top:11px\"></div>\n          <div class=\"statusbar\" style=\"padding:12px 20px 0; font-size:12px\"><span>9:41</span><div class=\"icons\"><svg class=\"icon\" style=\"width:12px;height:12px\"><use href=\"#i-wifi\"/></svg></div></div>\n          <div class=\"scr-content\" style=\"padding:15px 15px 10px; gap:10px\">\n            <div class=\"between\"><div class=\"h2\" style=\"font-size:16px\">Vault</div><span class=\"chip local\"><svg class=\"icon\" style=\"width:10px;height:10px\"><use href=\"#i-shield\"/></svg>Private</span></div>\n            <div class=\"input-pill\" style=\"padding:9px 12px; font-size:12px\"><svg class=\"icon\" style=\"width:14px;height:14px\"><use href=\"#i-search\"/></svg>Search memory</div>\n            <div class=\"grid2\">\n              <div class=\"card\" style=\"padding:10px;\"><svg class=\"icon\" style=\"stroke:var(--text-2)\"><use href=\"#i-folder\"/></svg><div style=\"font-size:12px;margin-top:6px\">Documents</div><div class=\"muted\" style=\"font-size:10.5px\">128 items</div></div>\n              <div class=\"card\" style=\"padding:10px;\"><svg class=\"icon\" style=\"stroke:var(--text-2)\"><use href=\"#i-doc\"/></svg><div style=\"font-size:12px;margin-top:6px\">Notes</div><div class=\"muted\" style=\"font-size:10.5px\">54 items</div></div>\n            </div>\n            <div class=\"card\" style=\"padding:12px;\">\n              <div class=\"cap\" style=\"margin-bottom:4px\">Context the agent remembers</div>\n              <div class=\"muted\" style=\"font-size:12px\">Home address, work calendar, three ongoing projects</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"screen-label\"><div class=\"name\">Memory / Vault</div><div class=\"desc\">Categorized, searchable, local-only</div></div>\n    </div>\n\n    <!-- CONNECTIONS -->\n    <div class=\"screen-block\">\n      <div class=\"phone small\">\n        <div class=\"screen\">\n          <div class=\"island\" style=\"width:76px;height:22px;top:11px\"></div>\n          <div class=\"statusbar\" style=\"padding:12px 20px 0; font-size:12px\"><span>9:41</span><div class=\"icons\"><svg class=\"icon\" style=\"width:12px;height:12px\"><use href=\"#i-wifi\"/></svg></div></div>\n          <div class=\"scr-content\" style=\"padding:15px 15px 10px; gap:10px\">\n            <div class=\"h2\" style=\"font-size:16px\">Connections</div>\n            <div class=\"card\" style=\"padding:6px 12px;\">\n              <div class=\"list-item\">\n                <div class=\"icon-tile success\" style=\"width:28px;height:28px\"><svg class=\"icon\" style=\"width:13px;height:13px\"><use href=\"#i-link\"/></svg></div>\n                <div style=\"flex:1\"><div style=\"font-size:12.5px;font-weight:500\">Local model</div><div class=\"muted\" style=\"font-size:10.5px\">On-device · always available</div></div>\n                <span class=\"chip local\" style=\"font-size:9.5px\">Local</span>\n              </div>\n              <div class=\"list-item\">\n                <div class=\"icon-tile\" style=\"width:28px;height:28px\"><svg class=\"icon\" style=\"width:13px;height:13px; stroke:var(--text-2)\"><use href=\"#i-link\"/></svg></div>\n                <div style=\"flex:1\"><div style=\"font-size:12.5px;font-weight:500\">Calendar</div><div class=\"muted\" style=\"font-size:10.5px\">Connected · remote</div></div>\n                <span class=\"chip\" style=\"font-size:9.5px\">Remote</span>\n              </div>\n              <div class=\"list-item\">\n                <div class=\"icon-tile danger\" style=\"width:28px;height:28px\"><svg class=\"icon\" style=\"width:13px;height:13px\"><use href=\"#i-x\"/></svg></div>\n                <div style=\"flex:1\"><div style=\"font-size:12.5px;font-weight:500\">Gmail</div><div class=\"muted\" style=\"font-size:10.5px\">Not connected</div></div>\n                <span class=\"muted\" style=\"font-size:11px; color:var(--accent)\">Connect</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"screen-label\"><div class=\"name\">API / Connections</div><div class=\"desc\">Local vs remote made explicit</div></div>\n    </div>\n\n    <!-- SETTINGS -->\n    <div class=\"screen-block\">\n      <div class=\"phone small\">\n        <div class=\"screen\">\n          <div class=\"island\" style=\"width:76px;height:22px;top:11px\"></div>\n          <div class=\"statusbar\" style=\"padding:12px 20px 0; font-size:12px\"><span>9:41</span><div class=\"icons\"><svg class=\"icon\" style=\"width:12px;height:12px\"><use href=\"#i-wifi\"/></svg></div></div>\n          <div class=\"scr-content\" style=\"padding:15px 15px 10px; gap:10px\">\n            <div class=\"h2\" style=\"font-size:16px\">Settings</div>\n            <div class=\"card\" style=\"padding:2px 12px;\">\n              <div class=\"list-item\"><span style=\"font-size:12.5px;flex:1\">Background execution</span><div class=\"toggle on\"></div></div>\n              <div class=\"list-item\"><span style=\"font-size:12.5px;flex:1\">Privacy mode</span><div class=\"toggle on\"></div></div>\n              <div class=\"list-item\"><span style=\"font-size:12.5px;flex:1\">Storage</span><span class=\"muted\" style=\"font-size:11.5px\">1.4 GB</span><svg class=\"icon\" style=\"width:13px;height:13px;stroke:var(--text-3)\"><use href=\"#i-chevron\"/></svg></div>\n              <div class=\"list-item\"><span style=\"font-size:12.5px;flex:1\">Appearance</span><span class=\"muted\" style=\"font-size:11.5px\">Dark</span><svg class=\"icon\" style=\"width:13px;height:13px;stroke:var(--text-3)\"><use href=\"#i-chevron\"/></svg></div>\n              <div class=\"list-item\"><span style=\"font-size:12.5px;flex:1\">About</span><svg class=\"icon\" style=\"width:13px;height:13px;stroke:var(--text-3)\"><use href=\"#i-chevron\"/></svg></div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"screen-label\"><div class=\"name\">Settings</div><div class=\"desc\">Grouped, native iOS list style</div></div>\n    </div>\n\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <!-- ============ INTERACTION STATES ============ -->\n  <div class=\"section-head\">\n    <div class=\"section-title\">Interaction states</div>\n    <div class=\"section-sub\">The same status card, in every state the agent can be in. Color and motion carry the meaning — layout never changes.</div>\n  </div>\n\n  <div class=\"states-grid\">\n    <div class=\"state-card\">\n      <div class=\"tag\">Idle</div>\n      <span class=\"pill ready\"><span class=\"pdot\"></span>Ready</span>\n      <div class=\"muted\">Waiting for a task. No motion, orb static.</div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Thinking</div>\n      <span class=\"pill thinking\"><span class=\"pdot\"></span>Thinking</span>\n      <div class=\"muted\">Orb rotates slowly, gradient breathing.</div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Running</div>\n      <span class=\"pill running\"><span class=\"pdot\"></span>Running</span>\n      <div class=\"progressbar\"><div style=\"width:52%\"></div></div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Completed</div>\n      <div class=\"row\"><div class=\"icon-tile success\"><svg class=\"icon\"><use href=\"#i-check\"/></svg></div><span style=\"font-size:13px\">Task finished</span></div>\n      <div class=\"muted\">Card settles to a quiet success tint for 2s, then returns to idle.</div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Failed</div>\n      <div class=\"row\"><div class=\"icon-tile danger\"><svg class=\"icon\"><use href=\"#i-x\"/></svg></div><span style=\"font-size:13px\">Couldn't finish</span></div>\n      <div class=\"muted\">Reason shown inline, with a Retry action.</div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Offline</div>\n      <div class=\"row\"><div class=\"icon-tile\"><svg class=\"icon\" style=\"stroke:var(--offline)\"><use href=\"#i-cloudoff\"/></svg></div><span class=\"pill offline\"><span class=\"pdot\"></span>Offline</span></div>\n      <div class=\"muted\">On-device tasks still work; remote ones queue.</div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Empty</div>\n      <div class=\"muted\" style=\"text-align:center; padding:14px 0;\">No activity yet.<br>Give your agent its first task.</div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Loading</div>\n      <div class=\"orb-wrap\" style=\"padding:0\"><div class=\"orb\" style=\"width:52px;height:52px\"></div></div>\n      <div class=\"muted\" style=\"text-align:center\">Preparing your agent…</div>\n    </div>\n    <div class=\"state-card\">\n      <div class=\"tag\">Permission required</div>\n      <div class=\"row\"><div class=\"icon-tile warning\"><svg class=\"icon\"><use href=\"#i-shield\"/></svg></div><span style=\"font-size:13px\">Calendar access needed</span></div>\n      <div class=\"btn ghost\" style=\"height:36px; font-size:12.5px\">Grant access</div>\n    </div>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <!-- ============ DESIGN SYSTEM ============ -->\n  <div class=\"section-head\">\n    <div class=\"section-title\">Design system</div>\n    <div class=\"section-sub\">Reference for SwiftUI implementation — colors, type, spacing, radius.</div>\n  </div>\n\n  <div class=\"cap\" style=\"margin-bottom:10px\">Color</div>\n  <div class=\"tok-row\" style=\"margin-bottom:32px\">\n    <div class=\"swatch\" style=\"background:var(--bg-1)\"><span class=\"lbl\">bg / 1 · #0A0A0D</span></div>\n    <div class=\"swatch\" style=\"background:var(--bg-2)\"><span class=\"lbl\">bg / 2 · #141417</span></div>\n    <div class=\"swatch\" style=\"background:var(--bg-4)\"><span class=\"lbl\">bg / 4 · #26262C</span></div>\n    <div class=\"swatch\" style=\"background:var(--accent)\"><span class=\"lbl\" style=\"color:#0A0A0D\">accent · #7C8CFF</span></div>\n    <div class=\"swatch\" style=\"background:var(--success)\"><span class=\"lbl\" style=\"color:#0A0A0D\">success · #3DD68C</span></div>\n    <div class=\"swatch\" style=\"background:var(--warning)\"><span class=\"lbl\" style=\"color:#0A0A0D\">warning · #F5B84D</span></div>\n    <div class=\"swatch\" style=\"background:var(--danger)\"><span class=\"lbl\" style=\"color:#0A0A0D\">danger · #F5716B</span></div>\n    <div class=\"swatch\" style=\"background:var(--offline)\"><span class=\"lbl\" style=\"color:#0A0A0D\">offline · #8B8B92</span></div>\n  </div>\n\n  <div class=\"cap\" style=\"margin-bottom:10px\">Typography — Inter / SF Pro, two weights only (500, 600)</div>\n  <div style=\"margin-bottom:32px\">\n    <div class=\"type-row\"><div class=\"tlabel\">Display / 34 · 600</div><div style=\"font-size:34px; font-weight:600; letter-spacing:-.01em\">Your agent</div></div>\n    <div class=\"type-row\"><div class=\"tlabel\">Title / 22 · 600</div><div style=\"font-size:22px; font-weight:600\">The full system</div></div>\n    <div class=\"type-row\"><div class=\"tlabel\">Body / 15 · 500</div><div style=\"font-size:15px; font-weight:500\">Organizing travel receipts</div></div>\n    <div class=\"type-row\"><div class=\"tlabel\">Secondary / 13 · 400</div><div style=\"font-size:13px; color:var(--text-2)\">Reading 12 files in Vault → Documents</div></div>\n    <div class=\"type-row\"><div class=\"tlabel\">Caption / 11 · 500</div><div style=\"font-size:11px; color:var(--text-3)\">2h ago · Local</div></div>\n  </div>\n\n  <div class=\"cap\" style=\"margin-bottom:10px\">Spacing (8pt grid) &amp; radius</div>\n  <div class=\"grid2\" style=\"gap:32px; margin-bottom:8px\">\n    <div>\n      <div class=\"spacing-row\" style=\"margin-bottom:10px\"><span class=\"muted\" style=\"width:36px\">4</span><div class=\"spacing-bar\" style=\"width:4px\"></div></div>\n      <div class=\"spacing-row\" style=\"margin-bottom:10px\"><span class=\"muted\" style=\"width:36px\">8</span><div class=\"spacing-bar\" style=\"width:8px\"></div></div>\n      <div class=\"spacing-row\" style=\"margin-bottom:10px\"><span class=\"muted\" style=\"width:36px\">16</span><div class=\"spacing-bar\" style=\"width:16px\"></div></div>\n      <div class=\"spacing-row\" style=\"margin-bottom:10px\"><span class=\"muted\" style=\"width:36px\">24</span><div class=\"spacing-bar\" style=\"width:24px\"></div></div>\n      <div class=\"spacing-row\"><span class=\"muted\" style=\"width:36px\">32</span><div class=\"spacing-bar\" style=\"width:32px\"></div></div>\n    </div>\n    <div class=\"row\" style=\"gap:20px; align-items:flex-end\">\n      <div style=\"width:56px; height:56px; background:var(--bg-3); border:1px solid var(--hair); border-radius:12px; display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--text-3)\">12</div>\n      <div style=\"width:56px; height:56px; background:var(--bg-3); border:1px solid var(--hair); border-radius:20px; display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--text-3)\">20</div>\n      <div style=\"width:56px; height:56px; background:var(--bg-3); border:1px solid var(--hair); border-radius:28px; display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--text-3)\">28 / pill</div>\n    </div>\n  </div>\n\n  <footer>Personal Agent — UI concept · dark mode primary · SwiftUI reference</footer>\n</div>\n</body>\n</html>\n"}